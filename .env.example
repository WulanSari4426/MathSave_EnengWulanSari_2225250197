# Salin file ini menjadi .env, lalu isi nilainya.
# File .env TIDAK BOLEH masuk Git (sudah diatur di .gitignore).
# Lihat docs/architecture.md bagian 8.

# --- Dipakai frontend (boleh publik, dilindungi RLS) ---
# URL proyek Supabase, contoh: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Kunci publik (anon / publishable) dari dasbor Supabase
VITE_SUPABASE_ANON_KEY=

# --- RAHASIA: hanya untuk skrip pengelola di komputer lokal ---
# JANGAN diberi awalan VITE_ agar tidak pernah ikut ke frontend.
# Untuk Edge Function, simpan sebagai secret di Supabase, bukan di sini.
SUPABASE_SERVICE_ROLE_KEY=
RAHASIA_KODE=
